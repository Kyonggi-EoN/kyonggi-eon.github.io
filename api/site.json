---
# 메뉴와 프로젝트 목록을 JSON으로 내보냅니다 → https://kyonggi-eon.github.io/api/site.json
# 다른 리포의 프로젝트 사이트에 붙는 상단 바(assets/js/eon-bar.js)가 이 파일을 읽습니다.
permalink: /api/site.json
layout: null
sitemap: false
---
{%- assign projects = site.projects | sort: "order", "last" -%}
{
  "title": {{ site.title | jsonify }},
  "url": {{ "/" | absolute_url | jsonify }},
  "logo": {{ "/assets/images/logo.svg" | absolute_url | jsonify }},
  "nav": [
    {%- for item in site.data.navigation %}
    {
      "title": {{ item.title | jsonify }},
      "url": {% if item.url contains "://" %}{{ item.url | jsonify }}{% else %}{{ item.url | absolute_url | jsonify }}{% endif %}
    }{% unless forloop.last %},{% endunless %}
    {%- endfor %}
  ],
  "projects": [
    {%- for p in projects %}
    {
      "title": {{ p.title | jsonify }},
      "summary": {{ p.summary | jsonify }},
      "url": {{ p.url | absolute_url | jsonify }},
      "site": {% if p.site == nil %}null{% elsif p.site contains "://" %}{{ p.site | jsonify }}{% else %}{{ p.site | absolute_url | jsonify }}{% endif %},
      "repo": {% if p.repo %}{{ "https://github.com/" | append: p.repo | jsonify }}{% else %}null{% endif %},
      "status": {{ p.status | jsonify }},
      "tags": {{ p.tags | jsonify }}
    }{% unless forloop.last %},{% endunless %}
    {%- endfor %}
  ]
}
